# Copy to `.env` for local overrides. Development works with these defaults.

# Rails server port. Change when running multiple worktrees.
PORT=3000

# Shakapacker dev-server port.
SHAKAPACKER_DEV_SERVER_PORT=3035

# React on Rails Pro Node renderer.
RENDERER_HOST=localhost
RENDERER_PORT=3800
RENDERER_PASSWORD=devPassword
RENDERER_WORKERS_COUNT=3

# Required in production. Generate with `bin/rails secret` or `openssl rand -hex 64`.
# SECRET_KEY_BASE=replace-me

# Optional, only when production encrypted credentials are required.
# RAILS_MASTER_KEY=replace-me

# Required by React on Rails Pro deployments. Never commit the real value.
# REACT_ON_RAILS_PRO_LICENSE=replace-me

# Optional GitHub OAuth for higher GitHub API limits.
# GITHUB_CLIENT_ID=replace-me
# GITHUB_CLIENT_SECRET=replace-me

# Tiny Control Plane/Kamal-style deploys can run Solid Queue inside Puma.
SOLID_QUEUE_IN_PUMA=true
