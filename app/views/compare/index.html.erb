<main class="octo-page octo-page--compare">
  <section class="octo-section-header octo-section-header--page">
    <div>
      <p class="octo-eyebrow">Compare releases</p>
      <h1>Compare changelogs</h1>
      <p class="octo-lead octo-lead--compact">
        Choose a repository and version range. Rails streams the grouped release notes through React Server Components while the browser hydrates only the filters.
      </p>
    </div>

    <% if @compare_filters_props[:repo].present? %>
      <span class="octo-pill">
        <%= "#{@compare_filters_props[:repo]} · #{@compare_filters_props[:from].presence || "?"} → #{@compare_filters_props[:to].presence || "?"}" %>
      </span>
    <% end %>
  </section>

  <% if @compare_flash.present? %>
    <div class="octo-flash octo-flash--<%= @compare_flash[:tone] %>"><%= @compare_flash[:message] %></div>
  <% end %>

  <div class="octo-compare-layout">
    <div class="octo-sidebar-column">
      <%= react_component("CompareFiltersStandalone", props: @compare_filters_props, prerender: true) %>
    </div>

    <div class="octo-results-column">
      <%= stream_react_component("OctochangelogCompareResultsPage", props: @compare_results_props) %>
    </div>
  </div>
</main>
