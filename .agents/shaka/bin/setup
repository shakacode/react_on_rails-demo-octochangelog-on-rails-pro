#!/usr/bin/env bash
# Managed by shakacode/agent-workflows binstub contract.
# Install dependencies and prepare the development database without starting the server.
set -euo pipefail
root=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_COMMON_DIR -u GIT_PREFIX -u GIT_CEILING_DIRECTORIES git -C "$(dirname -- "$0")" rev-parse --show-toplevel) || exit $?
cd "$root"
exec bin/setup --skip-server "$@"
