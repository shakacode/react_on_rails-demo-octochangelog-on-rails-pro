#!/bin/bash
set -euo pipefail

IMAGE_TAG="${IMAGE_TAG:-ror-tanstack:smoke}"
CONTAINER_NAME="${CONTAINER_NAME:-ror-tanstack-smoke}"
HOST_PORT="${HOST_PORT:-3002}"
BASE_URL="${BASE_URL:-http://127.0.0.1:${HOST_PORT}}"
BUILD_IMAGE="${BUILD_IMAGE:-1}"
RENDERER_PASSWORD="${RENDERER_PASSWORD:-smokePassword}"

home_html="$(mktemp)"
compare_html="$(mktemp)"

cleanup() {
  docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true
  rm -f "$home_html" "$compare_html"
}

trap cleanup EXIT

docker rm -f "$CONTAINER_NAME" >/dev/null 2>&1 || true

if [ "$BUILD_IMAGE" = "1" ]; then
  docker build -t "$IMAGE_TAG" .
fi

docker run -d --rm \
  --name "$CONTAINER_NAME" \
  -p "${HOST_PORT}:80" \
  -e SECRET_KEY_BASE_DUMMY=1 \
  -e RENDERER_PASSWORD="$RENDERER_PASSWORD" \
  "$IMAGE_TAG" >/dev/null

for attempt in $(seq 1 40); do
  if curl -fsS "$BASE_URL/" >"$home_html" 2>/dev/null; then
    break
  fi

  if [ "$attempt" -eq 40 ]; then
    echo "Container did not become ready at $BASE_URL" >&2
    docker logs "$CONTAINER_NAME" >&2 || true
    exit 1
  fi

  sleep 1
done

curl -fsS "$BASE_URL/compare" >"$compare_html"

grep -q "Octochangelog on Rails Pro" "$home_html"
grep -q "Compare GitHub changelogs with Rails at the edge" "$compare_html"
grep -q "Server components waiting" "$compare_html"

echo "Container smoke test passed for $BASE_URL"
